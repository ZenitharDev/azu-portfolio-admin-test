---
import Placeholder from './Placeholder.astro';
import { withBase } from '../utils/url';

interface Props {
  slug: string;
  title: string;
  engine: string;
  year: number;
  summary: string;
  heroImage: string;
}

const { slug, title, engine, year, summary, heroImage } = Astro.props;
---

<a
  href={withBase(`work/${slug}/`)}
  style="display: block; text-decoration: none; color: inherit; background: var(--surface); border: 1px solid var(--border); border-radius: 4px; overflow: hidden"
>
  <Placeholder src={heroImage} alt="Level image" height="220px" style="border-radius: 0" />
  <div style="padding: 24px">
    <div style="display: flex; gap: 8px; margin-bottom: 14px">
      <span class="tag tag--accent">{engine}</span>
      <span class="tag tag--muted">{year}</span>
    </div>
    <h3 style="font-family: var(--font-display); font-size: 20px; margin: 0 0 10px; font-weight: 600">{title}</h3>
    <p style="font-size: 14px; color: var(--text-muted); line-height: 1.5; margin: 0">{summary}</p>
  </div>
</a>
